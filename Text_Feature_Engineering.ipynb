    "X_tfidf_tr, X_tfidf_te, _,    _    = train_test_split(X_tfidf, y, test_size=0.2, random_state=42, stratify=y)\n",
    "\n",
    "print(f'Train size: {X_bow_tr.shape[0]}  |  Test size: {X_bow_te.shape[0]}')"
